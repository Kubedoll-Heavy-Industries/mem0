{
  "name": "mem0ai",
  "version": "2.1.38",
  "description": "The Memory Layer For Your AI Apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ],
      "oss": [
        "./dist/oss/index.d.ts"
      ],
      "community": [
        "./dist/community/index.d.ts"
      ],
      "community/langchain": [
        "./dist/community/integrations/langchain/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./oss": {
      "types": "./dist/oss/index.d.ts",
      "require": "./dist/oss/index.js",
      "import": "./dist/oss/index.mjs"
    },
    "./community": {
      "types": "./dist/community/index.d.ts",
      "require": "./dist/community/index.js",
      "import": "./dist/community/index.mjs"
    },
    "./community/langchain": {
      "types": "./dist/community/integrations/langchain/index.d.ts",
      "require": "./dist/community/integrations/langchain/index.js",
      "import": "./dist/community/integrations/langchain/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npx prettier --check . && npx tsup",
    "dev": "npx nodemon",
    "start": "pnpm run example memory",
    "example": "ts-node src/oss/examples/vector-stores/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/testcontainers/",
    "format": "npm run clean && prettier --write .",
    "format:check": "npm run clean && prettier --check ."
  },
  "keywords": [
    "mem0",
    "api",
    "client",
    "memory",
    "llm",
    "long-term-memory",
    "ai"
  ],
  "author": "Deshraj Yadav",
  "maintainers": [
    {
      "name": "Cadence Agyirey",
      "email": "8145742+cagyirey@users.noreply.github.com",
      "url": "https://github.com/cagyirey"
    }
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@testcontainers/postgresql": "^11.10.0",
    "@types/node": "^25.0.0",
    "@types/uuid": "^9.0.0",
    "dotenv": "^17.0.0",
    "fix-tsup-cjs": "^1.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.0",
    "testcontainers": "^11.10.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "openai": "^6.0.0",
    "uuid": "^9.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@azure/identity": "^4.0.0",
    "@azure/search-documents": "^12.0.0",
    "@cloudflare/workers-types": "^4.20251225.0",
    "@google/genai": "^1.34.0",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@mistralai/mistralai": "^1.11.0",
    "@qdrant/js-client-rest": "^1.16.0",
    "@supabase/supabase-js": "^2.89.0",
    "@types/pg": "^8.16.0",
    "@types/sqlite3": "^3.1.11",
    "cloudflare": "^5.0.0",
    "groq-sdk": "^0.37.0",
    "neo4j-driver": "^6.0.0",
    "ollama": "^0.6.0",
    "pg": "^8.16.0",
    "redis": "^5.0.0",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
